{
  "name": "viktor-slideshow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "sync": "bunx convex dev --once",
    "sync:build": "bunx convex dev --once && bun run build",
    "logs": "bunx convex logs",
    "logs:fetch": "bun run --bun scripts/logs.ts",
    "test:auth": "bun run --bun scripts/auth.ts",
    "check:phi-functions": "bun run --bun scripts/check-phi-authenticated-functions.ts",
    "generate:phi-statics": "bun run --bun scripts/generate-phi-console-statics.ts",
    "screenshot": "bun run --bun scripts/screenshot.ts",
    "env:get": "bunx convex env get",
    "env:list": "bunx convex env list",
    "test": "bun test scripts/slideshow.test.ts",
    "test:e2e": "bun run scripts/slideshow-test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@convex-dev/auth": "^0.0.94",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.122",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.1",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@~5.9.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "@babel/core": "7.29.7",
    "browserslist": "4.28.7",
    "esbuild": "0.28.1",
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "picomatch": "4.0.5"
  }
}
