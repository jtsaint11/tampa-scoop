# Frontend (Cloudflare Pages build). Set automatically by `npx convex deploy --cmd ...`
VITE_CONVEX_URL=

# Cloudflare Pages build env: production deploy key from the Convex dashboard
# CONVEX_DEPLOY_KEY=

# Convex deployment env (set with `npx convex env set`, never commit):
# SMARTSHEET_TOKEN=
# BEEHIIV_API_KEY=
# DESK_ALLOWED_EMAILS=jtsaint11@gmail.com   (optional; defaults to ALLOWED_EMAILS in convex/lib/desk.ts)
# JWT_PRIVATE_KEY= / JWKS= / SITE_URL=      (Convex Auth; generate with `npx @convex-dev/auth`)
